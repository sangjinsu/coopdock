COOPDOCK_IMAGE=ghcr.io/sangjinsu/coopdock:latest
# Select a published sha-<full-commit-SHA> tag, or pin @sha256:<digest> for exact image contents.

# Publish on the local Docker host by default. Use 0.0.0.0 for LAN access.
COOPDOCK_BIND_IP=127.0.0.1
COOPDOCK_PORT=8080

# Comma-separated game IDs. Each game has separate rooms and admission.
GAME_IDS=default
# GAME_IDS=default,campfire

# Empty disables the admin dashboard. To enable it, use your own 32-256
# printable ASCII bytes without spaces (0x21-0x7e); never commit the token.
ADMIN_VIEWER_TOKEN=

# Set only when additional browser origins are needed. Hosts only; no scheme.
# Never set WS_ORIGINS to an empty value.
# WS_ORIGINS=localhost:8080,127.0.0.1:8080

# HTTP_ADDR is fixed inside the container by compose.yaml; change the host port above.
